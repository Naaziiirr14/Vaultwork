PORT=5000
MONGO_URI=paste_your_atlas_connection_string_here
JWT_SECRET=change_this_to_a_long_random_string

# Frontend URL(s) allowed by CORS (comma separated). Vercel URL production la add pannunga.
CLIENT_URL=http://localhost:5173

# Razorpay TEST keys (Dashboard -> Account & Settings -> API Keys -> Test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# true na Razorpay illama "Simulate payment" button work aagum (demo/backup ku mattum)
ALLOW_MOCK_PAYMENT=true

# Submit pannitu client respond pannala na ethana naal la auto-release (0.001 = ~1.5 min, demo ku)
AUTO_RELEASE_DAYS=7
